shared {
  let N = 8;
  let Global = 1..9;
  let Global2 = [1..3, 1..7, Global];
}

main {
  let s: list(list(int));
  for i in 0..Global2.at(2).at(6) {
    s.push(1..i+1);
  }

  for i in s {
    print(i);
    for j in i {
      print(j);
    }
  }

  let v = s.at(3);
  let v = v.at(1);
  print("=========");
  print(v);
}